		"ai": "^7.0.106",
		"better-auth": "^1.7.1",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4.28",
		"pg": "^8.20.0",
		"unpdf": "^1.8.1",
		"zod": "^4.4.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
