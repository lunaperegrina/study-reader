{
	"name": "study-reader",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.29.3",
	"description": "Open .study course format + KOReader plugin for active study on e-readers",
	"scripts": {
		"study-format:test": "pnpm --filter @study-reader/study-format test",
		"study-format:check": "pnpm --filter @study-reader/study-format check",
		"study-format:example": "pnpm --filter @study-reader/study-format example",
		"converter:test": "pnpm --filter @study-reader/mdx-to-study test",
		"converter:check": "pnpm --filter @study-reader/mdx-to-study check",
		"study:build": "node packages/mdx-to-study/src/cli.ts",
		"plugin:deploy": "bash packages/koreader-plugin/deploy.sh",
		"plugin:remote": "bash packages/koreader-plugin/tools/kindle-remote.sh",
		"plugin:test": "cd packages/koreader-plugin && luajit tests/run.lua",
		"plugin:check": "cd packages/koreader-plugin && luajit -e \"for _, f in ipairs({'_meta','main','md2xhtml','quiz','review','screens','srs','state','store','courselist','exam','examcore'}) do assert(loadfile('plugin/studyreader.koplugin/' .. f .. '.lua'), f) end print('lua syntax OK')\"",
		"dev": "pnpm --parallel --filter @study-reader/api --filter @study-reader/web dev",
		"api:dev": "pnpm --filter @study-reader/api dev",
		"api:check": "pnpm --filter @study-reader/api check",
		"api:test": "pnpm --filter @study-reader/api test",
		"api:db:generate": "pnpm --filter @study-reader/api db:generate",
		"api:db:migrate": "pnpm --filter @study-reader/api db:migrate",
		"api:db:studio": "pnpm --filter @study-reader/api db:studio",
		"web:dev": "pnpm --filter @study-reader/web dev",
		"web:build": "pnpm --filter @study-reader/web build",
		"web:check": "pnpm --filter @study-reader/web check",
		"web:test": "pnpm --filter @study-reader/web test",
		"contracts:check": "pnpm --filter @study-reader/contracts check",
		"contracts:test": "pnpm --filter @study-reader/contracts test",
		"test": "pnpm -r --if-present test",
		"check": "pnpm -r --if-present check"
	}
}
