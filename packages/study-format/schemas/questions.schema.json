{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://study-reader.dev/schemas/questions.schema.json",
	"title": ".study quiz bank",
	"description": "Question map for a .study course package (spec v1)",
	"type": "object",
	"minProperties": 1,
	"propertyNames": {
		"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
		"maxLength": 128
	},
	"additionalProperties": {
		"type": "object",
		"required": ["type", "question", "options", "correct"],
		"properties": {
			"type": {
				"enum": ["single-choice", "multiple-choice"]
			},
			"question": {
				"type": "string",
				"minLength": 1
			},
			"code": {
				"type": "string"
			},
			"options": {
				"type": "array",
				"minItems": 2,
				"items": {
					"type": "object",
					"required": ["id", "text"],
					"properties": {
						"id": {
							"type": "string",
							"pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
							"maxLength": 32
						},
						"text": {
							"type": "string",
							"minLength": 1
						}
					},
					"additionalProperties": false
				}
			},
			"correct": {
				"type": "array",
				"minItems": 1,
				"items": {
					"type": "string"
				}
			},
			"explanation": {
				"type": "string"
			}
		},
		"additionalProperties": false
	}
}
