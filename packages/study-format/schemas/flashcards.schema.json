{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://study-reader.dev/schemas/flashcards.schema.json",
	"title": ".study flashcard deck",
	"description": "Flashcard array for a .study course package (spec v1)",
	"type": "array",
	"items": {
		"type": "object",
		"required": ["id", "front", "back"],
		"properties": {
			"id": {
				"type": "string",
				"pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
				"maxLength": 128
			},
			"front": {
				"type": "string",
				"minLength": 1
			},
			"back": {
				"type": "string",
				"minLength": 1
			},
			"tags": {
				"type": "array",
				"items": {
					"type": "string",
					"maxLength": 64
				}
			}
		},
		"additionalProperties": false
	}
}
